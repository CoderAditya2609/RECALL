{
  "entities": {
    "AppAccount": {
      "path": "appAccounts/{username}",
      "description": "Student account credentials (username, display name, password hash, created date)",
      "fields": {
        "id": "string",
        "username": "string",
        "displayName": "string",
        "password": "string",
        "createdAt": "string",
        "lastActiveAt": "string"
      }
    },
    "User": {
      "path": "users/{userId}",
      "description": "Private student profile, preferences, settings, and Gemini BYOK configuration",
      "fields": {
        "email": "string",
        "displayName": "string",
        "username": "string",
        "createdAt": "string",
        "totalMistakesCount": "number",
        "unresolvedCount": "number",
        "geminiApiKey": "string",
        "preferences": "object"
      }
    },
    "PublicUser": {
      "path": "publicUsers/{userId}",
      "description": "Public searchable user profile (username, activity status, minimal identifier)",
      "fields": {
        "id": "string",
        "username": "string",
        "displayName": "string",
        "photoURL": "string",
        "createdAt": "string",
        "lastActiveAt": "string"
      }
    },
    "Subject": {
      "path": "users/{userId}/subjects/{subjectId}",
      "description": "Academic subject taxonomy with chapters and topics",
      "fields": {
        "name": "string",
        "color": "string",
        "chapters": "array",
        "createdAt": "string"
      }
    },
    "Mistake": {
      "path": "users/{userId}/mistakes/{mistakeId}",
      "description": "Individual academic mistake notebook entry",
      "fields": {
        "subjectId": "string",
        "subjectName": "string",
        "chapter": "string",
        "topic": "string",
        "source": "string",
        "questionNumber": "string",
        "questionText": "string",
        "questionImage": "string",
        "annotations": "array",
        "whatWentWrong": "string",
        "correctApproach": "string",
        "whyMadeMistake": "string",
        "takeaway": "string",
        "mistakeType": "string",
        "severity": "string",
        "status": "string",
        "voiceMemo": "object",
        "occurrencesCount": "number",
        "relatedPatternId": "string",
        "reviewedAt": "string",
        "createdAt": "string",
        "updatedAt": "string"
      }
    },
    "Exam": {
      "path": "users/{userId}/exams/{examId}",
      "description": "Target exam with syllabus, score reflection, and relevant mistake tracking",
      "fields": {
        "name": "string",
        "date": "string",
        "targetScore": "number",
        "actualScore": "number",
        "totalMarks": "number",
        "syllabus": "array",
        "notes": "string",
        "postExamObservations": "string",
        "createdAt": "string"
      }
    },
    "Insight": {
      "path": "users/{userId}/insights/{insightId}",
      "description": "Gemini-powered diagnostic analysis, pattern alerts, and study prescriptions",
      "fields": {
        "type": "string",
        "title": "string",
        "content": "string",
        "detectedAt": "string",
        "recurringTopic": "string",
        "mistakeIds": "array",
        "severity": "string",
        "recommendedAction": "string"
      }
    },
    "CalendarEvent": {
      "path": "users/{userId}/calendarEvents/{eventId}",
      "description": "Academic calendar event, test dates, revision blocks",
      "fields": {
        "title": "string",
        "date": "string",
        "type": "string",
        "subject": "string",
        "relatedExamId": "string",
        "completed": "boolean"
      }
    },
    "Conversation": {
      "path": "conversations/{conversationId}",
      "description": "Private 1-on-1 chat conversation between two authenticated users",
      "fields": {
        "participantIds": "array",
        "participantUsernames": "object",
        "lastMessage": "string",
        "lastMessageAt": "string",
        "lastSenderId": "string",
        "createdAt": "string"
      }
    },
    "ChatMessage": {
      "path": "conversations/{conversationId}/messages/{messageId}",
      "description": "Encrypted message in a private conversation",
      "fields": {
        "senderId": "string",
        "senderUsername": "string",
        "message": "string",
        "createdAt": "string",
        "read": "boolean"
      }
    },
    "PublicQuestionBankDoc": {
      "path": "publicQuestionBank/{docId}",
      "description": "Shared public Question Bank documents (PDFs, images, exam papers up to 50MB)",
      "fields": {
        "uploaderId": "string",
        "uploaderUsername": "string",
        "title": "string",
        "subject": "string",
        "chapter": "string",
        "fileType": "string",
        "fileSize": "number",
        "fileUrl": "string",
        "totalPages": "number",
        "tags": "array",
        "description": "string",
        "createdAt": "string"
      }
    },
    "UserQuestionBankAnnotation": {
      "path": "users/{userId}/qbAnnotations/{docId}",
      "description": "User-specific independent personal annotation layer (highlights, marks, doodles) on a public question bank document",
      "fields": {
        "documentId": "string",
        "userId": "string",
        "annotations": "array",
        "highlights": "array",
        "marks": "array",
        "doodleData": "string",
        "updatedAt": "string"
      }
    }
  }
}
