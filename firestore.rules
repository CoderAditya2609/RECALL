rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. App Accounts (Direct username + password student accounts)
    match /appAccounts/{username} {
      allow read, write: if isAuthenticated();
    }

    // 2. Private User Profile & Subcollections
    match /users/{userId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 3. Public User Directory (Searchable handles and presence)
    match /publicUsers/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Study Chat Conversations & Messages
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 5. Public Question Bank Documents
    match /publicQuestionBank/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
